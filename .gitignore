# ---------------------------------------------------------------- environments
# jarvis-env is the live one; venv and backend/jarvis-env are empty leftovers.
# Recreate with: py -3.12 -m venv jarvis-env && pip install -r requirements.txt
jarvis-env/
venv/
backend/jarvis-env/
__pycache__/
*.py[cod]
node_modules/

# ---------------------------------------------------------------- voice models
# ~63 MB each. Too large for git, and re-downloadable:
#   https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_GB/<voice>/<quality>/<file>
models/piper/*.onnx
models/vosk/

# ---------------------------------------------------------------- private data
# jarvis_memory.db holds remembered personal facts and full conversation
# history. It must never be committed.
backend/data/*.db
backend/*.db
backend/data/claude_last.txt
backend/data/last_search.txt

# ---------------------------------------------------------------- scratch
# Pre-git backups. Superseded by git history; safe to delete.
*.bak
*.bak[0-9]
*.tmp
*.tmp.html
capability_report.txt
command_report.txt

# Unrelated files that happen to live in this folder. Not project code.
# Remove these lines if you actually want them versioned here.
*.zip
